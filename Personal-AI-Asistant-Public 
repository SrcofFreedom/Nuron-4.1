def media_tugmesi_bas(kod_deyeri):
    """Media və səs düymələrini xətasız simulyasiya edir"""
    vbs_yolu = "C:\\nuron_media.vbs"
    try:
        # VBS faylını təmiz şəkildə yaradırıq
        with open(vbs_yolu, "w", encoding="utf-8") as f:
            f.write(f'Set WshShell = CreateObject("WScript.Shell")\n')
            f.write(f'WshShell.SendKeys chr({kod_deyeri})\n')
        
        # Faylı icra edirik
        subprocess.run(["wscript.exe", vbs_yolu], timeout=5)
        
        # İşimiz bitəndən sonra faylı silirik ki, zibil qalmasın
        if os.path.exists(vbs_yolu):
            os.remove(vbs_yolu)
    except Exception as e:
        print(f"[Media Xətası]: {e}")

